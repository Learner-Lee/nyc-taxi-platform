# ============================================================
# NYC Taxi Platform — 统一环境变量
# 修改这里，所有容器自动生效
# ============================================================

# --- 版本 ---
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.4.1
POSTGRES_VERSION=15

# --- HDFS ---
HDFS_NAMENODE_HOST=namenode
HDFS_PORT=9000
HDFS_REPLICATION=2
HDFS_BLOCK_SIZE=134217728

# --- Spark ---
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_CORES=2
SPARK_HISTORY_PORT=18080

# --- Hive Metastore ---
HIVE_METASTORE_PORT=9083

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyc_taxi
POSTGRES_USER=taxi_user
POSTGRES_PASSWORD=taxi_pass123
POSTGRES_METASTORE_DB=hive_metastore

# --- Jupyter ---
JUPYTER_PORT=8888
JUPYTER_TOKEN=

# --- 数据路径（容器内） ---
HDFS_BASE_PATH=hdfs://namenode:9000/nyc-taxi
DATA_MOUNT_PATH=/data
